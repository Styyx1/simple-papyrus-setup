<?xml version='1.0'?>
<PapyrusProject xmlns="PapyrusProject.xsd" 
    Flags="TESV_Papyrus_Flags.flg" 
    Game="sse"
    Anonymize="true" 
    Output="Scripts" 
    Optimize="false" 
    Release="false" 
    Zip="false"
    Package="false"
    Final="false">
    <Variables>
        <Variable Name="ModsFolder", Value="PATH_TO_MODS"/>
    </Variables>
    <Imports>
        <!-- <Import>@ModsFolder\SKSE64\Scripts\Source</Import> -->
        <Import>YOUR_CREATION_KIT_INSTALL_WITH_UNPACKED_SCRIPTZIP/Data/Source/Scripts</Import>
    </Imports>
    <Folders>
        <!-- Relative path to folder containing .psc Papyrus source code files for this project -->
        <Folder>./Source/Scripts</Folder>
    </Folders>
</PapyrusProject>