<?xml version='1.0'?>
<PapyrusProject xmlns="PapyrusProject.xsd"
    Flags="TESV_Papyrus_Flags.flg"
    Game="sse"
    Anonymize="true"
    Output="./Scripts"
    Optimize="false"
    Release="false"
    Zip="false"
    Package="false"
    Final="false">
    <Variables>
        <Variable Name="ModsFolder" Value="PATH_TO_MODS" />
    </Variables>
    <!-- Import conflicts are solved like this: TOP overwrites BOTTOM -->
    <Imports>
        <!-- <Import>@ModsFolder/Skyrim Script Extender (SKSE64)  Steam/Scripts/Source/</Import> -->
        <Import>PATH_TO_VANILLA_SOURCES_CONTAINING_FLG_FILE</Import>
    </Imports>
    <Folders>
        <!-- Relative path to folder containing .psc Papyrus source code files for this project -->
        <Folder>./Source/Scripts</Folder>
    </Folders>
</PapyrusProject>